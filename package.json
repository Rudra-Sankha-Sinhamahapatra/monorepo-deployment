{
  "name": "monorepo-deployment",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "prisma:generate": "cd packages/db && bunx prisma generate && cd ../..",
    "build:frontend": "cd apps/docs && bun run build && cd ../..",
    "start:frontend": "cd apps/docs && bun run start && cd ../..",
    "start:backend": "cd apps/node && bun run dev",
    "start:websocket": "cd apps/websocket && bun run dev"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.5.2",
    "typescript": "5.8.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.2.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
